spring:
  application:
    name: keyflex-backend

  datasource:
    url: jdbc:postgresql://localhost:5432/postgres
    username: postgres
    password: root
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
    baseline-version: 0
    clean-disabled: true

  sql:
    init:
      mode: never

jwt:
  secret: beccd90a1da85fb4b5250c83da4f5b97566cd50cf23f37f6110fcee6918ccfff
  access-token-expiration: 900000
  refresh-token-expiration: 604800000
